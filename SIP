<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Year Up United &times; Social Impact Partners | Healthcare Talent Strategies</title>
<meta name="description" content="Year Up United and Social Impact Partners partner with Connecticut healthcare organizations to design talent strategies that strengthen the workforce.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700;800;900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #10203B;
    --navy-deep: #0B1730;
    --red: #FE6500;
    --red-dark: #D45400;
    --paper: #FBFBFC;
    --card: #FFFFFF;
    --ink: #1C2536;
    --slate: #5A6478;
    --line: #E3E7EE;
    --orange: #FE6500;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Libre Franklin', -apple-system, sans-serif;
    background: var(--paper);
    color: var(--ink);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Hero ─────────────────────────────── */
  header {
    background: linear-gradient(160deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: #fff;
    padding: 4rem 1.5rem 4.5rem;
    position: relative;
    overflow: hidden;
  }
  header::before {
    content: "";
    position: absolute;
    top: -140px; right: -140px;
    width: 420px; height: 420px;
    border-radius: 50%;
    border: 60px solid rgba(254,101,0,0.14);
    pointer-events: none;
  }
  header::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 5px;
    background: var(--orange);
  }
  .hero-inner { max-width: 880px; margin: 0 auto; position: relative; }
  .brandline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #A9B8D4;
    margin-bottom: 1.5rem;
  }
  .brandline .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--red); }
  h1 {
    font-weight: 900;
    font-size: clamp(2rem, 5.5vw, 3.2rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    max-width: 20ch;
  }
  h1 em {
    font-family: 'Source Serif 4', serif;
    font-style: italic;
    font-weight: 400;
    color: var(--orange);
  }
  .hero-sub {
    margin-top: 1.25rem;
    font-size: 1.08rem;
    line-height: 1.65;
    color: #C4CFE2;
    max-width: 56ch;
  }

  /* ── Main ─────────────────────────────── */
  main {
    flex: 1;
    max-width: 880px;
    width: 100%;
    margin: 0 auto;
    padding: 0 1.5rem 3.5rem;
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: -2.25rem;
    position: relative;
    z-index: 2;
  }
  @media (max-width: 680px) { .cards { grid-template-columns: 1fr; } }

  .action-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 2rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 10px 30px rgba(16,32,59,0.09);
  }
  .card-kicker {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--red);
  }
  .card-title { font-size: 1.45rem; font-weight: 800; letter-spacing: -0.01em; }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: inherit;
    font-weight: 700;
    font-size: 0.98rem;
    padding: 0.95rem 1.4rem;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn:focus-visible { outline: 3px solid var(--orange); outline-offset: 2px; }
  .btn-red { background: var(--red); color: #fff; }
  .btn-red:hover { background: var(--red-dark); }
  .btn-navy { background: var(--navy); color: #fff; }
  .btn-navy:hover { background: var(--navy-deep); }

  footer {
    background: var(--navy);
    color: #9FB0CC;
    text-align: center;
    font-size: 0.8rem;
    padding: 1.4rem 1.5rem;
    line-height: 1.7;
  }
  footer strong { color: #fff; font-weight: 700; }

  .toast {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%) translateY(130%);
    background: var(--navy);
    color: #fff;
    padding: 0.85rem 1.25rem;
    border-radius: 8px;
    font-size: 0.85rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    transition: transform 0.25s ease;
    max-width: 90vw;
  }
  .toast.show { transform: translateX(-50%) translateY(0); }

  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
</head>
<body>

<header>
  <div class="hero-inner">
    <div class="brandline">Year Up United <span class="dot"></span> Social Impact Partners <span class="dot"></span> Connecticut</div>
    <h1>Building <em>future forward</em> healthcare <em>talent strategies</em>, together.</h1>
  </div>
  </div>
</header>

<main>
  <div class="cards">

    <div class="action-card">
      <div class="card-kicker">New Partnership</div>
      <div class="card-title">Share a Lead</div>
      <a class="btn btn-red" id="btn-lead" href="#" data-key="NEW_LEAD_FORM_URL" target="_blank" rel="noopener">Share a Lead</a>
    </div>

    <div class="action-card">
      <div class="card-kicker">Ongoing Engagement</div>
      <div class="card-title">Record an Engagement</div>
      <a class="btn btn-navy" id="btn-interaction" href="#" data-key="LOG_INTERACTION_FORM_URL" target="_blank" rel="noopener">Log a Call or Meeting</a>
    </div>

  </div>

</main>

<footer>
  <strong>Year Up United &times; Social Impact Partners</strong> &middot; Healthcare Talent Strategies
</footer>

<div class="toast" id="toast"></div>

<script>
  /* ════════════════════════════════════════════════════
     CONFIG — paste your Airtable form share links here
     1. NEW_LEAD_FORM_URL: "Share a Lead" form (Leads table)
     2. LOG_INTERACTION_FORM_URL: "Record an Engagement" form (Communication table)
     ════════════════════════════════════════════════════ */
  const CONFIG = {
    NEW_LEAD_FORM_URL: "PASTE_REFERRAL_FORM_LINK_HERE",
    LOG_INTERACTION_FORM_URL: "PASTE_ENGAGEMENT_FORM_LINK_HERE"
  };

  document.querySelectorAll("[data-key]").forEach(el => {
    const url = CONFIG[el.dataset.key];
    if (url && url.startsWith("http")) {
      el.href = url;
    } else {
      el.addEventListener("click", e => {
        e.preventDefault();
        showToast("This button isn't connected yet. Paste the form link into the CONFIG block in this file.");
      });
    }
  });

  function showToast(msg) {
    const t = document.getElementById("toast");
    t.textContent = msg;
    t.classList.add("show");
    clearTimeout(t._timer);
    t._timer = setTimeout(() => t.classList.remove("show"), 4000);
  }
</script>

</body>
</html>
